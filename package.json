    "test:chat-perf": "node --test scripts/run-chat-perf-tests.mjs",
    "test:chat-streaming": "node --test scripts/run-chat-streaming-tests.mjs",
    "test:abuse-limits": "node --test scripts/run-abuse-limit-tests.mjs",
    "test:guardrails": "node --test scripts/run-guardrail-tests.mjs",
    "test:tool-scope": "node --conditions=react-server --test scripts/run-tool-scope-tests.mjs",
