# Environment variables for AI Sales (Waves AI Pilot).
#
# This file documents every variable the app reads, grouped by feature.
# lib/env.ts validates them at server startup (names only are ever logged).
# It is tracked in git; never put a real secret in it. Copy it to .env.local
# (local dev) or set the values in your host's environment (staging/prod).
#
# --- Environments: development, staging and production are SEPARATE ---
# Use one Supabase project, one Clerk instance and one Gemini key per
# environment:
#   development (your machine)  -> staging Supabase (or a dev project),
#                                  Clerk development instance (pk_test_),
#                                  GEMINI_API_KEY_DEV
#   staging (CI / preview)      -> staging Supabase, Clerk development or a
#                                  staging instance, GEMINI_API_KEY_DEV
#   production (VPS / Vercel)   -> production Supabase, Clerk PRODUCTION
#                                  instance (pk_live_), GEMINI_API_KEY
# Local development must NOT point at the production Supabase project. Every
# script and test refuses to run against it (scripts/lib/production-guard.mjs),
# and the server prints an `env_target_warning` line at startup if it does.
# Also relink the CLI: `npx supabase link --project-ref <staging ref>`.
#
# Which environment this process is. Optional on Vercel (VERCEL_ENV is used:
# production -> production, preview -> staging), but REQUIRED on a VPS or any
# other `next start` host: a production server with neither APP_ENV nor
# VERCEL_ENV refuses to start, so it can never silently use the dev Gemini key.
# One of: development | staging | production
APP_ENV=development
# Extra Supabase project refs to treat as production (comma-separated). The
# current production ref (bykeztxvejpwfcxgsubm) is built in and can't be
# removed; add a ref here if production ever moves (e.g. a Mumbai project).
PRODUCTION_SUPABASE_PROJECT_REFS=

# --- Phase 2: Clerk authentication (required as of this phase) ---
# Get these from your Clerk Dashboard: https://dashboard.clerk.com
# Organizations must be enabled, Membership mode set to "Membership required".
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Phase 3: Supabase + PostgreSQL foundation (required as of this phase) ---
# Get these from your Supabase project settings: https://supabase.com/dashboard
# Current key naming (legacy anon/service_role keys are being deprecated by
# end of 2026): https://supabase.com/docs/guides/api/api-keys
# Clerk must be configured as a Supabase third-party auth provider —
# see supabase/config.toml's [auth.third_party.clerk] block.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Required as of Phase 11: the public chat widget endpoint (app/api/chat)
# has no Clerk session to authenticate against, so it uses this
# RLS-bypassing service-role client (lib/supabase/service.ts) instead.
# Never expose client-side; restricted to that one request path.
SUPABASE_SECRET_KEY=

# --- Phase 7: Gemini embedding provider; Phase 8 adds chat generation ---
# Get this from Google AI Studio: https://aistudio.google.com/apikey
#
# Token-burn audit (STATE.md, 2026-10-28): split into two keys so a local
# dev run, a Vercel preview deploy, or any scripts/*.mjs run can never
# silently spend the production key. lib/env.ts enforces this at startup:
#   - Production (APP_ENV=production, or Vercel's VERCEL_ENV=production):
#     needs GEMINI_API_KEY. GEMINI_API_KEY_DEV is not read there.
#   - Everywhere else (local .env.local, staging, Vercel Preview env, every
#     scripts/*.mjs run): needs GEMINI_API_KEY_DEV instead. Missing it
#     fails loudly at startup rather than falling back to GEMINI_API_KEY.
# Create a second Google AI Studio key (ideally in its own Google Cloud
# project, so you can put a budget alert on it) and use it as
# GEMINI_API_KEY_DEV everywhere except the Vercel Production environment.
GEMINI_API_KEY=
GEMINI_API_KEY_DEV=
# Resolved decision D3 (STATE.md): gemini-embedding-001, truncated to 1536
# dimensions (see lib/embeddings.ts -- manual L2-normalization required,
# this model does not auto-normalize non-3072-dimension output).
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=1536
# Wired starting Phase 8 (lib/rag.ts -- minimal grounding/fallback prompt).
# Phase 9 extends the system prompt with the full sales persona; this is
# not a model change, just a prompt change. Confirmed live against
# ai.google.dev at Phase 7 prompt-writing time.
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite

# --- Phase 21: Error tracking (Sentry) ---
# Optional, not validated by lib/env.ts -- Sentry.init() with an
# undefined DSN silently no-ops rather than throwing, so a missing
# value degrades observability, not the app itself. Project:
# waves-web-studio/ai-sales (Sentry's DE region). Same DSN value for
# both -- SENTRY_DSN is read server/edge-side (instrumentation.ts),
# NEXT_PUBLIC_SENTRY_DSN client-side (instrumentation-client.ts).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Org-scoped auth token (org:ci scope only), used at build time by
# next.config.ts's withSentryConfig to upload source maps. Never the
# broader user token used one-time to create the Sentry project.
SENTRY_AUTH_TOKEN=
# Distributed tracing sample rate, 0-1 (default 0 = off, which protects the
# free tier's transaction quota). Try 0.05 if you need traces. Events are
# tagged with APP_ENV, so filter production alerts on environment:production.
SENTRY_TRACES_SAMPLE_RATE=

# --- Per-tenant AI usage quota: no longer an environment variable ---
# AI_MONTHLY_TOKEN_LIMIT (Phase 22h) was removed in Phase 17a. The quota
# is now per-plan, counted in AI replies over the business's own billing
# period, and defined in lib/plans.ts -- the same registry /pricing
# renders from. There is nothing to configure here: changing a plan's
# quota is a code change, deliberately, because it is also a change to
# what this product publicly sells.

# --- Background jobs: the scheduler (production readiness item 3) ---
# REQUIRED in production, at least 16 characters (`openssl rand -base64 32`).
# Every scheduler trigger sends it as `Authorization: Bearer $CRON_SECRET`:
#   - the VPS crontab / systemd timer calling POST /api/cron/run every 1-2
#     minutes (docs/vps-cron.md), and
#   - Vercel's daily cron (/api/cron/process-ingestion-queue), which Vercel
#     signs with this automatically.
# Without it (or with a shorter one) both routes return 404 and NO background
# job runs. Left unset in local dev; ingestion still runs via after().
CRON_SECRET=

# --- Phase 25b: handoff/lead email notifications ---
# Optional -- lib/notifications.ts's daily digest is a silent no-op (one
# log line, not an error) when unset, so the app runs fine without it.
# Get an API key from https://resend.com. Without a Resend-verified
# sending domain, delivery is limited to the Resend account owner's own
# verified address (their sandbox mode). Every send goes through
# lib/email-sender.ts.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend. Defaults to
# Resend's own sandbox address (onboarding@resend.dev) if unset, which
# only delivers to the Resend account owner. Keep the "Name <address>"
# form: prospect-facing mail rewrites only the display name, to
# "<Business> via Waves AI Pilot", and keeps this address.
# Prefer a dedicated sending subdomain (e.g. notifications@mail.example.com)
# over the root domain, so automated mail's bounce/complaint history never
# touches the reputation of the domain the business itself sends from.
NOTIFICATION_EMAIL_FROM=Waves AI Pilot <onboarding@resend.dev>
# Signing secret for app/api/webhooks/resend/route.ts (starts "whsec_").
# Shown when you add the webhook endpoint in the Resend dashboard;
# subscribe it to email.bounced and email.complained. Optional -- with it
# unset the webhook refuses every request (401) and bounce suppression
# simply never receives events.
RESEND_WEBHOOK_SECRET=

# Where operational alerts are emailed (production readiness item 6): a
# deleted customer's Razorpay subscription that could not be cancelled, or a
# charge that arrived after deletion. Optional -- each alert is also an
# error-level Sentry event. Use your own inbox, not a customer-facing one.
OPS_ALERT_EMAIL=

# Which header holds the real client IP, for every per-IP rate limit
# (lib/http/client-ip.ts):
#   xff-first  -- default; correct on Vercel (it overwrites X-Forwarded-For)
#   xff-last   -- behind ONE reverse proxy that appends (nginx's default
#                 $proxy_add_x_forwarded_for); the last entry is the one nginx saw
#   x-real-ip  -- nginx with `proxy_set_header X-Real-IP $remote_addr;`
# On the VPS use x-real-ip or xff-last. xff-first behind nginx's default is
# spoofable: a client could send any X-Forwarded-For and dodge rate limits.
CLIENT_IP_SOURCE=

# Absolute base URL for links inside emails (the dashboard links in the
# digest and appointment alerts). Email is sent from the cron and from
# after() continuations, where there is no request to read a host from.
# Optional: when unset, lib/app-url.ts falls back to Vercel's own
# VERCEL_PROJECT_PRODUCTION_URL. Set it once the app has a custom domain.
# Not a secret -- it is a public URL.
NEXT_PUBLIC_APP_URL=

# --- Phase 16: WhatsApp (Meta Cloud API) ---
# App-level secrets (one Meta App serves every tenant's own connected
# number -- per-business phone_number_id/waba_id/access_token live in the
# whatsapp_connections/whatsapp_credentials tables instead, not here).
# Get WHATSAPP_APP_SECRET from your Meta App's Settings > Basic page.
WHATSAPP_APP_SECRET=
# A secret string you choose yourself, entered in the Meta App's
# WhatsApp > Configuration > Webhook setup alongside the callback URL
# (app/api/webhooks/whatsapp). Meta echoes it back during the one-time
# verification handshake -- must match exactly.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
#
# WhatsApp message templates (production readiness item 4). Outside the
# 24-hour customer-service window Meta delivers only APPROVED templates.
# Set each name ONLY after Meta approves it -- unset means "not approved
# yet", and a notice that needs it fails visibly (conversation flagged, the
# owner told) instead of being rejected by Meta. Templates are approved PER
# WhatsApp Business Account: every connected business's WABA needs these
# names approved. Exact bodies to submit: lib/whatsapp-templates.ts (also in
# LAUNCH_AUDIT.md's handoff list). Language code used for all of them:
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_APPOINTMENT_CONFIRMED=
WHATSAPP_TEMPLATE_APPOINTMENT_DECLINED=
WHATSAPP_TEMPLATE_APPOINTMENT_CANCELLED=
WHATSAPP_TEMPLATE_APPOINTMENT_REMINDER=
WHATSAPP_TEMPLATE_APPOINTMENT_EXPIRED=

# --- Instagram DM: Instagram API with Facebook Login (Meta) ---
# One Meta app serves every tenant. Each business's Instagram account id,
# Facebook Page id and (encrypted) Page access token live in the
# instagram_connections / instagram_credentials tables, not here.
# Every one of these is server-only: never prefix with NEXT_PUBLIC_.
#
# Meta app id (App Dashboard > App settings > Basic). Not a secret.
META_APP_ID=1876820120425285
# Meta app secret (same page). Signs webhooks, signed_request callbacks and
# the code exchange. There is NO separate "Instagram app secret" any more.
META_APP_SECRET=
# Facebook Login configuration id (App Dashboard > Facebook Login >
# Configurations) used by the login dialog. Not a secret. (The old Unified
# Login config was 1445378207559361.)
META_LOGIN_CONFIG_ID=
# Which login NEW connections use: facebook (default when unset) or
# unified (Instagram API with Unified Login, kept for a switch back; it
# needs the Unified Login config id in META_LOGIN_CONFIG_ID). Existing
# connections keep working in the mode they were made with.
META_IG_LOGIN_MODE=facebook
# Must exactly match a Valid OAuth Redirect URI in the Meta app.
META_REDIRECT_URI=https://aipilot.waveswebstudio.in/api/meta/instagram/callback
# A long random string you choose (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`).
# Paste the same value into App Dashboard > Webhooks (Instagram object) >
# Verify token. Callback URL:
# https://aipilot.waveswebstudio.in/api/meta/instagram/webhook
META_WEBHOOK_VERIFY_TOKEN=
# Graph API version for every graph.facebook.com call.
META_GRAPH_VERSION=v26.0
# 32 random bytes, base64 (or 64 hex chars), used to AES-256-GCM encrypt
# stored Instagram tokens (lib/token-crypto.ts). Generate with
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`.
# Changing it makes every stored token unreadable (businesses must reconnect).
META_TOKEN_ENCRYPTION_KEY=

# --- Phase 17b: Razorpay subscription lifecycle (TEST MODE ONLY) ---
# All six are optional. lib/razorpay.ts returns an explicit "not
# configured" outcome when any one of them is missing, rather than failing
# startup -- same posture as RESEND_API_KEY. With them unset the billing
# page says payments are not set up, the webhook refuses every request, and
# the daily billing sweep no-ops.
#
# NOTHING IN THIS PHASE IS LIVE. Use `rzp_test_*` keys. Going live is
# blocked on Phase 17c's GST invoices: charging an Indian customer without
# issuing a tax invoice is not lawful (STATE.md).
#
# Get the key id and secret from the Razorpay Dashboard:
# Account & Settings > API Keys (Test Mode). The key id is PUBLIC -- it is
# sent to the browser so Checkout can open -- but is deliberately not
# NEXT_PUBLIC_*, since it is only ever handed to an authenticated
# org:admin by a Server Action. The secret signs API requests and verifies
# Checkout callbacks; never expose or log it.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# A DIFFERENT secret from the key secret above. Shown once, when you add
# the webhook endpoint in the Razorpay Dashboard
# (Account & Settings > Webhooks > Add New Webhook) at
# https://<your-domain>/api/webhooks/razorpay. Subscribe it to:
# subscription.activated, subscription.charged, subscription.pending,
# subscription.halted, subscription.cancelled, subscription.completed,
# payment.failed, order.paid.
# app/api/webhooks/razorpay/route.ts FAILS CLOSED without it (401 on every
# request) -- an unauthenticated version of that endpoint would let anyone
# POST a `subscription.charged` and grant themselves a Scale plan.
RAZORPAY_WEBHOOK_SECRET=
# The three MONTHLY subscription plans, created in the Razorpay Dashboard
# (Subscriptions > Plans) at the GST-INCLUSIVE gross amounts in
# lib/plans.ts: 149900 / 399900 / 999900 paise, INR, monthly, interval 1.
# lib/razorpay.ts re-verifies each against the registry before every
# subscription it creates -- a dashboard edit that changed an amount would
# otherwise mean charging a customer something other than the price
# /pricing advertises.
# There are deliberately NO annual plan ids: the annual option is a
# one-time Order, not a subscription, because RBI additional-factor rules
# make an annual mandate re-authenticate every cycle anyway.
RAZORPAY_PLAN_STARTER_MONTHLY=
RAZORPAY_PLAN_GROWTH_MONTHLY=
RAZORPAY_PLAN_SCALE_MONTHLY=

# --- Headless-rendering fallback for JS-rendered site knowledge ingestion ---
# Local development only. lib/browser-render.ts's production path
# (@sparticuz/chromium-min) only runs on Linux, so a developer on
# Windows/macOS points this at their own installed Chrome/Edge/Chromium to
# exercise this fallback locally, e.g.
# "C:\Program Files\Google\Chrome\Application\chrome.exe" on Windows, or
# "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" on macOS.
# Leave unset in production -- the deployed Vercel function always uses the
# remote chromium-min pack instead. On a VPS, point it at the system
# Chromium (e.g. /usr/bin/chromium) instead of downloading the x64 pack.
LOCAL_CHROMIUM_PATH=

# --- Operational tuning (all optional; safe defaults when unset) ---
# AI generation deadline for a whole turn, a single Gemini call, and a single
# read-only tool, in milliseconds (lib/chat-timeouts.ts). Defaults 50000 /
# 25000 / 15000. Must stay under the route's 60 s maxDuration.
CHAT_AI_DEADLINE_MS=
CHAT_MODEL_CALL_TIMEOUT_MS=
CHAT_TOOL_TIMEOUT_MS=
# How many times LangChain retries ONE failed Gemini call (0-3, default 1).
# LangChain's own default of 6 can't finish inside CHAT_MODEL_CALL_TIMEOUT_MS
# and hammers a throttled key (lib/chat-timeouts.ts).
CHAT_MODEL_MAX_RETRIES=
# USD->INR rate used only on /apache to compare Gemini cost (USD) with plan
# revenue (INR). Default 89. Never affects what a customer is charged.
USD_TO_INR_RATE=
# /api/health?deep=1 answers 503 when no scheduled job has started for this
# many minutes (default 15, right for a VPS cron every 1-2 minutes). On a
# Vercel-only deployment (daily cron) set 1500, or don't monitor ?deep=1.
HEALTH_SCHEDULER_MAX_AGE_MINUTES=
# "off" disables putting a small catalog straight into the prompt
# (lib/catalog-prefetch.ts). Default on.
CATALOG_PREFETCH=
# "off" restores the widget route's previous read ordering
# (app/api/chat/route.ts). Default on.
PIPELINE_PART_B=

# --- Plan access and trials (lib/entitlement-rules.ts; all optional) ---
# Hard cap on AI replies during the free trial (no card, 14 days, website +
# WhatsApp + Instagram). Whole number 1-100000. Default 200.
TRIAL_REPLY_QUOTA=
# When a subscription read fails, keep serving the last known plan for this
# many hours (0-168, default 24; 0 = never). With no last known plan the
# business gets no paid access. Every failure logs/alerts subscription_read_degraded.
SUBSCRIPTION_LAST_KNOWN_MAX_HOURS=

# --- Public chat protection (lib/chat-protection.ts, docs/abuse-protection.md; all optional) ---
# Enforcing limits per 5 minutes. Defaults 30 / 120 / 20 / 300.
CHAT_IP_LIMIT=
CHAT_KEY_LIMIT=
CHAT_CONVERSATION_LIMIT=
CHAT_BUSINESS_LIMIT=
# AI turns on the public widget per UTC day: per business (default 1000) and
# across all businesses (default 20000). 0 = no cap. Over the cap: no Gemini
# call, a fixed "a person will follow up" reply, the conversation flagged,
# gemini_daily_cap_reached alerted (OPS_ALERT_EMAIL, once an hour).
GEMINI_DAILY_TURN_CAP_PER_BUSINESS=
GEMINI_DAILY_TURN_CAP_GLOBAL=
# Cloudflare Turnstile for new widget conversations: off (default) | log | enforce.
# Needs BOTH keys; the site key is public (sent to the widget iframe), the
# secret key is server-only. Add only your app domain as the widget hostname.
TURNSTILE_MODE=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
